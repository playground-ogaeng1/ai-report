# ─────────────────────────────────────────────────────────────
# Supabase PostgreSQL 연결 정보 (루트 .env 에 복사해서 실제 값 입력)
#
# 값 얻는 곳: Supabase 대시보드 → 프로젝트 선택 → 상단 [Connect] 버튼
#   · [POOLER-HOST] 는 리전으로 추측하지 말고 Connect 창에서 그대로 복사하세요.
#   · [PASSWORD] 는 프로젝트 생성 시 정한 DB 비밀번호입니다.
#     비밀번호에 @ : / ? # 같은 문자가 있으면 URL 인코딩해야 합니다. (@ → %40)
# ─────────────────────────────────────────────────────────────

# ① 앱 런타임용 — Transaction pooler (포트 6543)
#    서버리스/다중 인스턴스에서 커넥션 고갈을 막아줍니다. pgbouncer=true 필수.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# ② 마이그레이션 / Prisma Studio 용 — Session pooler (포트 5432)
#    prisma migrate 는 풀러를 거치면 안 되므로 별도 URL 을 씁니다.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"

# ─────────────────────────────────────────────────────────────
# 아래 값들은 루트가 아니라 각 앱의 .env 에 넣습니다.
# 여기 적어둔 건 "무엇이 필요한지" 목록용입니다.
# ─────────────────────────────────────────────────────────────

# ■ apps/api/.env — Claude API
#   키는 절대 web 에 두지 않습니다. 모든 Claude 호출은 api 를 경유합니다.
#   발급: https://platform.claude.com → API keys
# ANTHROPIC_API_KEY="sk-ant-..."

# ■ apps/web/.env.local — Supabase Auth (구글 로그인)
#   Supabase 대시보드 → Project Settings → API 에서 프로젝트 URL 과 공개 키를
#   가져옵니다. 구글 프로바이더 설정은 Authentication → Providers → Google.
#   구글 Cloud Console 에 등록할 리디렉션 URI 는 Supabase 가 알려주는
#   https://<project-ref>.supabase.co/auth/v1/callback 입니다.
#   (변수명은 Phase 1 재구현 때 설치할 패키지 버전에 맞춰 확정)

# ■ apps/api/.env — Supabase JWT 검증용 키
#   api 는 web 이 보낸 Supabase 액세스 토큰(JWT)을 검증해서 호출자를 식별합니다.
#   (Phase 1 재구현 때 확정)
