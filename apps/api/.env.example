# 백엔드(NestJS) 전용 설정
# DB 연결 정보(DATABASE_URL / DIRECT_URL)는 루트 .env 에 있고,
# ConfigModule 이 ['.env', '../../.env'] 순서로 둘 다 읽습니다.

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Supabase 액세스 토큰(JWT) 검증용 프로젝트 URL.
# 공개키를 <SUPABASE_URL>/auth/v1/.well-known/jwks.json 에서 가져오므로
# 시크릿이 아닙니다. (이 프로젝트는 ES256 비대칭 키 사용)
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# 파일 저장소(Supabase Storage) 접근용 시크릿 키.
# 대시보드 → Project Settings → API → `sb_secret_...` 값.
# ⚠️ 이 키는 RLS 를 우회하므로 절대 web/브라우저에 노출하면 안 됩니다.
#    없으면 서버는 뜨지만 파일 업로드만 503 으로 실패합니다.
SUPABASE_SECRET_KEY="sb_secret_..."

# Claude API 키 — 첨삭/면접에 필요합니다.
# 발급: https://platform.claude.com → API keys
# ⚠️ 절대 web/브라우저로 넘기지 마세요. 모든 Claude 호출은 api 를 경유합니다.
#    없으면 서버는 뜨지만 첨삭만 503 으로 실패합니다.
ANTHROPIC_API_KEY="sk-ant-..."

# 비용 가드 — 사용자 1인당 최근 24시간 토큰 한도.
# 넘으면 Claude 를 쓰는 엔드포인트가 429 로 막힙니다 (조회·등록은 계속 동작).
# 생략하면 300000 이 적용됩니다.
# DAILY_TOKEN_LIMIT=300000

# 관리자 — /admin/* 운영 조회(API 호출 기록·백엔드 로그)에 접근할 이메일.
# 쉼표로 여러 개. 구글 로그인에 쓰는 이메일과 같아야 합니다.
# **비워 두면 아무도 접근할 수 없습니다** (실수로 전원 공개되지 않도록).
# ADMIN_EMAILS="you@example.com"
